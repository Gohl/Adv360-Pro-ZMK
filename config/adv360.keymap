#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-unless-interrupted";
            bindings = <&kp>, <&kp>;
        };

        dvkkp_n1: dvkkp_n1 {
            compatible = "zmk,behavior-mod-morph";
            label = "dvkkp_n1";
            bindings = <&kp EXCLAMATION>, <&kp NUMBER_1>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI|MOD_RCTL|MOD_LCTL|MOD_LALT|MOD_RALT)>;
            keep-mods = <(MOD_RCTL|MOD_LCTL|MOD_LGUI|MOD_RGUI|MOD_RALT|MOD_LALT)>;
        };

        dvkkp_n2: dvkkp_n2 {
            compatible = "zmk,behavior-mod-morph";
            label = "dvkkp_n2";
            bindings = <&kp AT_SIGN>, <&kp NUMBER_2>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI|MOD_RCTL|MOD_LCTL|MOD_LALT|MOD_RALT)>;
            keep-mods = <(MOD_RCTL|MOD_LCTL|MOD_LGUI|MOD_RGUI|MOD_RALT|MOD_LALT)>;
        };

        dvkkp_n3: dvkkp_n3 {
            compatible = "zmk,behavior-mod-morph";
            label = "dvkkp_n3";
            bindings = <&kp HASH>, <&kp NUMBER_3>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI|MOD_RCTL|MOD_LCTL|MOD_LALT|MOD_RALT)>;
            keep-mods = <(MOD_RCTL|MOD_LCTL|MOD_LGUI|MOD_RGUI|MOD_RALT|MOD_LALT)>;
        };

        dvkkp_n4: dvkkp_n4 {
            compatible = "zmk,behavior-mod-morph";
            label = "dvkkp_n4";
            bindings = <&kp DOLLAR>, <&kp NUMBER_4>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI|MOD_RCTL|MOD_LCTL|MOD_LALT|MOD_RALT)>;
            keep-mods = <(MOD_RCTL|MOD_LCTL|MOD_LGUI|MOD_RGUI|MOD_RALT|MOD_LALT)>;
        };

        dvkkp_n5: dvkkp_n5 {
            compatible = "zmk,behavior-mod-morph";
            label = "dvkkp_n5";
            bindings = <&kp PERCENT>, <&kp NUMBER_5>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI|MOD_RCTL|MOD_LCTL|MOD_LALT|MOD_RALT)>;
            keep-mods = <(MOD_RCTL|MOD_LCTL|MOD_LGUI|MOD_RGUI|MOD_RALT|MOD_LALT)>;
        };

        dvkkp_n6: dvkkp_n6 {
            compatible = "zmk,behavior-mod-morph";
            label = "dvkkp_n6";
            bindings = <&kp CARET>, <&kp NUMBER_6>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI|MOD_RCTL|MOD_LCTL|MOD_LALT|MOD_RALT)>;
            keep-mods = <(MOD_RCTL|MOD_LCTL|MOD_LGUI|MOD_RGUI|MOD_RALT|MOD_LALT)>;
        };

        dvkkp_n7: dvkkp_n7 {
            compatible = "zmk,behavior-mod-morph";
            label = "dvkkp_n7";
            bindings = <&kp AMPERSAND>, <&kp NUMBER_7>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI|MOD_RCTL|MOD_LCTL|MOD_LALT|MOD_RALT)>;
            keep-mods = <(MOD_RCTL|MOD_LCTL|MOD_LGUI|MOD_RGUI|MOD_RALT|MOD_LALT)>;
        };

        dvkkp_n8: dvkkp_n8 {
            compatible = "zmk,behavior-mod-morph";
            label = "dvkkp_n8";
            bindings = <&kp ASTERISK>, <&kp NUMBER_8>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI|MOD_RCTL|MOD_LCTL|MOD_LALT|MOD_RALT)>;
            keep-mods = <(MOD_RCTL|MOD_LCTL|MOD_LGUI|MOD_RGUI|MOD_RALT|MOD_LALT)>;
        };

        dvkkp_n9: dvkkp_n9 {
            compatible = "zmk,behavior-mod-morph";
            label = "dvkkp_n9";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp NUMBER_9>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI|MOD_RCTL|MOD_LCTL|MOD_LALT|MOD_RALT)>;
            keep-mods = <(MOD_RCTL|MOD_LCTL|MOD_LGUI|MOD_RGUI|MOD_RALT|MOD_LALT)>;
        };

        dvkkp_n0: dvkkp_n0 {
            compatible = "zmk,behavior-mod-morph";
            label = "dvkkp_n0";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp NUMBER_0>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI|MOD_RCTL|MOD_LCTL|MOD_LALT|MOD_RALT)>;
            keep-mods = <(MOD_RCTL|MOD_LCTL|MOD_LGUI|MOD_RGUI|MOD_RALT|MOD_LALT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        dvorak {
            display-name = "dvorak";
            bindings = <
&kp EQUAL  &dvkkp_n1  &dvkkp_n2  &dvkkp_n3  &dvkkp_n4  &dvkkp_n5  &to 1                                                            &mo 3          &dvkkp_n6  &dvkkp_n7  &dvkkp_n8     &dvkkp_n9  &dvkkp_n0  &kp MINUS
&kp TAB    &kp APOS   &kp COMMA  &kp DOT    &kp P      &kp Y      &kp F13                                                          &kp F14        &kp F      &kp G      &kp C         &kp R      &kp L      &kp BSLH
&kp ESC    &kp A      &kp O      &kp E      &kp U      &kp I      &kp RIGHT_ALT  &kp LCTRL  &kp LALT      &kp LEFT_WIN  &kp RCTRL  &kp RIGHT_ALT  &kp D      &kp H      &kp T         &kp N      &kp S      &kp FSLH
&kp LSHFT  &kp SEMI   &kp Q      &kp J      &kp K      &kp X                                &kp HOME      &kp PG_UP                               &kp B      &kp M      &kp W         &kp V      &kp Z      &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS   &kp LEFT   &kp RIGHT             &kp BSPC       &kp DEL    &kp END       &kp PG_DN     &kp ENTER  &kp SPACE                 &kp DOWN   &kp UP_ARROW  &kp LBKT   &kp RBKT   &mo 2
            >;
        };

        keypad {
            display-name = "keypad";
            bindings = <
&kp EQUAL  &trans     &trans     &trans    &trans     &trans  &to 4                                                    &mo 3           &kp SQT    &kp COMMA  &kp PERIOD  &trans            &trans    &kp MINUS
&kp TAB    &kp APOS   &kp COMMA  &kp DOT   &kp P      &kp Y   &none                                                    &kp KP_NUMLOCK  &kp F      &kp KP_N7  &kp KP_N8   &kp KP_N9         &kp L     &kp BSLH
&kp ESC    &kp A      &kp O      &kp E     &kp U      &kp I   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none           &kp D      &kp KP_N4  &kp KP_N5   &kp KP_N6         &kp S     &kp FSLH
&kp LSHFT  &kp SEMI   &kp Q      &kp J     &kp K      &kp X                        &kp HOME      &kp PG_UP                             &kp KP_N0  &kp KP_N1  &kp KP_N2   &kp KP_N3         &kp Z     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS   &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE                  &kp DOWN   &kp UP      &kp LEFT_BRACKET  &kp RBKT  &mo 2
            >;
        };

        fn {
            display-name = "fn";
            bindings = <
&kp F1  &kp F2     &kp F3     &kp F4  &kp F5     &kp F6  &tog 1                                      &mo 3           &kp F7           &kp F8           &kp F9           &kp F10          &kp F11    &kp F12
&trans  &trans     &trans     &trans  &trans     &trans  &none                                       &kp KP_NUMLOCK  &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans     &trans
&trans  &kp RA(Q)  &kp RA(P)  &trans  &kp RA(U)  &trans  &none   &trans  &trans      &trans  &trans  &none           &trans           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp RA(S)  &trans
&trans  &trans     &trans     &trans  &trans     &trans                  &trans      &trans                          &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans     &trans
&trans  &trans     &trans     &trans  &trans             &trans  &trans  &trans      &trans  &trans  &trans                           &trans           &trans           &trans           &trans     &trans
            >;
        };

        mod {
            display-name = "mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader             &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        gaming {
            display-name = "gaming";
            bindings = <
&kp ESC  &kp N1     &kp N2  &kp N3  &kp N4  &kp N5  &to 0                                               &trans  &kp F1  &kp F2  &kp F3  &kp F4     &kp F5   &kp F6
&kp TAB  &kp X      &kp Q   &kp W   &kp E   &kp R   &kp T                                               &to 0   &kp F7  &kp F8  &kp F9  &kp F10    &kp F11  &kp F12
&trans   &kp C      &kp A   &kp S   &kp D   &kp F   &trans     &kp ENTER  &trans        &trans  &trans  &trans  &kp T   &kp Z   &kp U   &kp O      &kp P    &kp G
&trans   &kp LSHFT  &kp N6  &kp N7  &kp N8  &kp N9                        &trans        &trans                  &kp H   &kp J   &kp K   &kp Y      &kp X    &kp B
&trans   &kp V      &trans  &kp I   &kp L           &kp SPACE  &kp LCTRL  &kp LALT      &trans  &trans  &trans          &kp N   &kp M   &kp COMMA  &kp DOT  &trans
            >;
        };
    };
};
